#!/usr/bin/env bash

set -eEu -o pipefail

status() {
    echo "### $1"
}

status "Building"
npm run build

status "Type checks (experimental decorators, then standard decorators)"
tsc -p tsconfig.type-tests.json
tsc -p tsconfig.type-tests-standard.json

status "Tree shaking"
agadoo dist/fudgel.mjs

status "ES2018 syntax only, so the documented browsers can parse it"
node -e "
const acorn = require('acorn');
const fs = require('fs');
for (const file of ['dist/fudgel.min.mjs', 'dist/fudgel.umd.min.js', 'dist/only-component.min.mjs']) {
    acorn.parse(fs.readFileSync(file, 'utf8'), { ecmaVersion: 2018, sourceType: file.endsWith('.mjs') ? 'module' : 'script' });
}
"

status "The dev module survives tree shaking"
node -e "
const pkg = require('./package.json');
const listed = Array.isArray(pkg.sideEffects) && pkg.sideEffects.includes('./dist/fudgel-dev.mjs');
if (!listed) { throw new Error('package.json sideEffects must list dist/fudgel-dev.mjs, or a bare import of fudgel/dev is dropped by bundlers'); }
"

status "Importable without a DOM"
node -e "import('./dist/fudgel.mjs').then(m => { if (typeof m.di != 'function') { throw new Error('fudgel did not load under Node'); } })"
node -e "if (typeof require('./dist/fudgel.cjs').di != 'function') { throw new Error('the CommonJS build did not load'); }"

status "Vitest (unit under Node, browser under Chromium)"
vitest run
